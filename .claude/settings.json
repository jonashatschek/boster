{
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python.exe -m pytest *)",
      "Bash(.venv/Scripts/python.exe -m scripts.inspect_report *)",
      "Bash(.venv/Scripts/python.exe -m scripts.dump_rows *)",
      "Bash(python -m pytest *)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npx tsc -b)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check.sh\"",
            "timeout": 180,
            "statusMessage": "Running Boster checks..."
          }
        ]
      }
    ]
  }
}
